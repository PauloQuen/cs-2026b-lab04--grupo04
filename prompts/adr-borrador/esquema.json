{
  "title": "ContratoBorradorADR",
  "description": "Contrato JSON Schema para redactar borradores de ADR a partir de notas de reunión en ChacraSmart Majes.",
  "type": "object",
  "required": ["reunion_id", "notas_suficientes", "preguntas", "adr"],
  "additionalProperties": false,
  "properties": {
    "reunion_id": {
      "type": "string",
      "minLength": 2
    },
    "notas_suficientes": {
      "type": "boolean"
    },
    "preguntas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "adr": {
      "type": ["object", "null"],
      "required": [
        "titulo",
        "estado",
        "contexto",
        "alternativas",
        "decision",
        "consecuencias_positivas",
        "consecuencias_negativas"
      ],
      "additionalProperties": false,
      "properties": {
        "titulo": { "type": "string", "minLength": 5 },
        "estado": { "type": "string", "enum": ["Propuesto", "Aceptado"] },
        "contexto": { "type": "string", "minLength": 15 },
        "alternativas": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 5 }
        },
        "decision": { "type": "string", "minLength": 15 },
        "consecuencias_positivas": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 5 }
        },
        "consecuencias_negativas": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 5 }
        }
      }
    }
  }
}
