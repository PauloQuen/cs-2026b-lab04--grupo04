@startuml
title <size:24>Deployment View: ChacraSmart Majes - Producción</size>\n<size:24>Despliegue en producción (MVP, un solo VPS — R-03).</size>

set separator none
left to right direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>
!include <C4/C4_Deployment>

Deployment_Node(Producción.CelulardelagricultorPCdeltécnico, "Celular del agricultor / PC del técnico", $type="Android · navegador web (gama baja, R-05)", $descr="", $tags="", $link="") {
  Container(Producción.CelulardelagricultorPCdeltécnico.PWA_1, "PWA", $techn="HTML / CSS / JavaScript (PWA)", $descr="Interfaz para agricultores y técnicos; ligera para celulares de gama baja y apta para señal intermitente.", $tags="", $link="")
}

Deployment_Node(Producción.ParcelaenMajes, "Parcela en Majes", $type="conexión intermitente (R-04)", $descr="", $tags="", $link="") {
  Deployment_Node(Producción.ParcelaenMajes.Controladordecampo, "Controlador de campo", $type="embebido, sensor + válvula, temporizador local (ADR-003)", $descr="", $tags="", $link="") {
    System(Producción.ParcelaenMajes.Controladordecampo.Controladordecampo_1, "Controlador de campo", $descr="Dispositivo en la parcela: lee el sensor, acciona la válvula y la cierra solo al cumplirse el tiempo programado aunque se pierda la conexión (ADR-003).", $tags="", $link="")
  }

}

Deployment_Node(Producción.VPSenlanube, "VPS en la nube", $type="Ubuntu 24.04 · 2 vCPU · 4 GB RAM (R-03, un solo VPS)", $descr="", $tags="", $link="") {
  Deployment_Node(Producción.VPSenlanube.DockerCompose, "Docker Compose", $type="Docker 27", $descr="", $tags="", $link="") {
    Container(Producción.VPSenlanube.DockerCompose.APIChacraSmart_1, "API ChacraSmart", $techn="Python / Django + gunicorn", $descr="Monolito modular: los casos de uso viven en cinco módulos de dominio que se comunican solo por interfaces públicas (ADR-001).", $tags="", $link="")
    Container(Producción.VPSenlanube.DockerCompose.Workerdetareas_1, "Worker de tareas", $techn="Celery", $descr="Ejecuta de forma asíncrona el envío de alertas y sus reintentos.", $tags="", $link="")
    ContainerDb(Producción.VPSenlanube.DockerCompose.Basededatos_1, "Base de datos", $techn="PostgreSQL 16", $descr="Lecturas, programaciones, válvulas, parcelas y usuarios; un esquema por módulo.", $tags="", $link="")
    ContainerQueue(Producción.VPSenlanube.DockerCompose.Colaycaché_1, "Cola y caché", $techn="Redis", $descr="Cola de tareas del worker y caché del estado de las válvulas abiertas (QA-01).", $tags="", $link="")
  }

}

Rel(Producción.CelulardelagricultorPCdeltécnico.PWA_1, Producción.VPSenlanube.DockerCompose.APIChacraSmart_1, "Llama a la API", $techn="HTTPS/JSON (REST)", $tags="", $link="")
Rel(Producción.VPSenlanube.DockerCompose.APIChacraSmart_1, Producción.ParcelaenMajes.Controladordecampo.Controladordecampo_1, "Envía órdenes de apertura y cierre", $techn="HTTP/JSON (ADR-002)", $tags="", $link="")
Rel(Producción.ParcelaenMajes.Controladordecampo.Controladordecampo_1, Producción.VPSenlanube.DockerCompose.APIChacraSmart_1, "Envía lecturas, acuses y eventos del temporizador local", $techn="HTTP/JSON (ADR-002)", $tags="", $link="")
Rel(Producción.VPSenlanube.DockerCompose.APIChacraSmart_1, Producción.VPSenlanube.DockerCompose.Basededatos_1, "Lee y escribe", $techn="SQL/TCP", $tags="", $link="")
Rel(Producción.VPSenlanube.DockerCompose.APIChacraSmart_1, Producción.VPSenlanube.DockerCompose.Colaycaché_1, "Encola alertas y cachea el estado de las válvulas", $techn="Redis protocol", $tags="", $link="")
Rel(Producción.VPSenlanube.DockerCompose.Workerdetareas_1, Producción.VPSenlanube.DockerCompose.Colaycaché_1, "Consume las tareas encoladas", $techn="Redis protocol", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml